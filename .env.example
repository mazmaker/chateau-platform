# CHATEAU Platform Environment Variables

# Database
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Service (Resend)
# Server-side only (for production deployment)
RESEND_API_KEY=re_your_resend_api_key_here
# Client-side (for development with Vite)
VITE_RESEND_API_KEY=re_your_resend_api_key_here

# Email Configuration
VITE_FROM_EMAIL=onboarding@resend.dev
VITE_FROM_NAME=CHATEAU Platform
VITE_BILLING_EMAIL=billing@chateau-platform.com
VITE_SUPPORT_PHONE=02-xxx-xxxx

# Customer LINE Login (optional — only needed for the customer LINE OAuth flow)
VITE_LINE_CHANNEL_ID=your_line_channel_id

# Environment
NODE_ENV=development
# Set to 'production' when ready for real email sending